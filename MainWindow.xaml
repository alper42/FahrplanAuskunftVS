<Window x:Class="FahrplanAuskunft.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FahrplanAuskunft"
        Title="Fahrplanauskunft" Height="780" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117" FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="#1F6FEB"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#1F6FEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1F6FEB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#388BFD"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#1158C7"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#30363D"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwapButton" TargetType="Button">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#8B949E"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                                <Setter Property="Foreground" Value="#E6EDF3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox Style -->
        <ControlTemplate x:Key="DarkComboBoxTemplate" TargetType="ComboBox">
            <Grid>
                <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0" Margin="12,8" VerticalAlignment="Center"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                        <TextBlock Grid.Column="1" Text="&#x25BE;" Foreground="#8B949E"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <ToggleButton Grid.ColumnSpan="2" Background="Transparent" BorderThickness="0"
                                      IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      Focusable="False" Opacity="0"/>
                    </Grid>
                </Border>
                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True">
                    <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8"
                            MinWidth="{TemplateBinding ActualWidth}">
                        <ScrollViewer MaxHeight="200">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template" Value="{StaticResource DarkComboBoxTemplate}"/>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1F6FEB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResultsListBox" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Autocomplete ListBox Style -->
        <Style x:Key="AutocompleteList" TargetType="ListBox">
            <Setter Property="Background" Value="#21262D"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
        </Style>

        <Style x:Key="AutocompleteItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="32,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1F6FEB" CornerRadius="10" Width="40" Height="40" Margin="0,0,14,0">
                        <TextBlock Text="&#x1F682;" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="FAHRPLANAUSKUNFT" FontSize="17" FontWeight="Bold" Foreground="#E6EDF3"/>
                        <TextBlock Text="Deutschlandweit  ·  Echte DB-Verbindungen" FontSize="11" Foreground="#8B949E"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CurrentTimeText" FontSize="20" FontWeight="Light" Foreground="#E6EDF3"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="CurrentDateText" FontSize="12" Foreground="#8B949E" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Search Panel -->
        <Border Grid.Row="1" Background="#161B22" Padding="32,20" BorderBrush="#30363D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- VON mit Autocomplete -->
                <Grid Grid.Column="0">
                    <StackPanel>
                        <TextBlock Text="VON" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtVon" Style="{StaticResource ModernTextBox}" Text="München Hbf"/>
                    </StackPanel>
                    <Popup x:Name="PopupVon" PlacementTarget="{Binding ElementName=TxtVon}"
                           Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                        <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8"
                                MinWidth="250" MaxHeight="220">
                            <ListBox x:Name="ListVon" Style="{StaticResource AutocompleteList}"
                                     ItemContainerStyle="{StaticResource AutocompleteItem}"
                                     BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="10,0">
                    <Button Style="{StaticResource SwapButton}" Content="&#x21C4;" Click="SwapStations_Click"/>
                </StackPanel>

                <!-- NACH mit Autocomplete -->
                <Grid Grid.Column="2">
                    <StackPanel>
                        <TextBlock Text="NACH" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtNach" Style="{StaticResource ModernTextBox}" Text="Berlin Hbf"/>
                    </StackPanel>
                    <Popup x:Name="PopupNach" PlacementTarget="{Binding ElementName=TxtNach}"
                           Placement="Bottom" AllowsTransparency="True" StaysOpen="False">
                        <Border Background="#21262D" BorderBrush="#30363D" BorderThickness="1" CornerRadius="8"
                                MinWidth="250" MaxHeight="220">
                            <ListBox x:Name="ListNach" Style="{StaticResource AutocompleteList}"
                                     ItemContainerStyle="{StaticResource AutocompleteItem}"
                                     BorderThickness="0" Background="Transparent"/>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="3" Margin="16,0,0,0">
                    <TextBlock Text="DATUM" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,6"/>
                    <DatePicker x:Name="DatumPicker" Width="155" Background="#21262D" Foreground="#E6EDF3"
                                BorderBrush="#30363D" FontSize="13"/>
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="12,0,0,0">
                    <TextBlock Text="UHRZEIT" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtZeit" Style="{StaticResource ModernTextBox}" Width="90" Text="08:00"/>
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="12,0,0,0">
                    <TextBlock Text="TYP" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbTyp" Style="{StaticResource DarkComboBox}" Width="120">
                        <ComboBoxItem Content="Abfahrt" IsSelected="True" Style="{StaticResource DarkComboBoxItem}"/>
                        <ComboBoxItem Content="Ankunft" Style="{StaticResource DarkComboBoxItem}"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="6" Margin="16,0,0,0" VerticalAlignment="Bottom">
                    <Button x:Name="SuchenBtn" Style="{StaticResource PrimaryButton}"
                            Content="Verbindungen suchen" Click="Suchen_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Results Area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Results -->
            <Border Grid.Column="0" Padding="32,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="ResultHeaderText" Grid.Column="0" Text="Verbindungen"
                                   FontSize="15" FontWeight="SemiBold" Foreground="#E6EDF3" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#21262D" CornerRadius="6" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Filter: " Foreground="#8B949E" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="FilterCombo" Style="{StaticResource DarkComboBox}"
                                          Width="130" SelectionChanged="FilterChanged">
                                    <ComboBoxItem Content="Alle" IsSelected="True" Style="{StaticResource DarkComboBoxItem}"/>
                                    <ComboBoxItem Content="Nur ICE/IC" Style="{StaticResource DarkComboBoxItem}"/>
                                    <ComboBoxItem Content="Nur RE/RB" Style="{StaticResource DarkComboBoxItem}"/>
                                    <ComboBoxItem Content="Umstiegsfrei" Style="{StaticResource DarkComboBoxItem}"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="EmptyState" Grid.Row="1" Visibility="Visible">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F689;" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Geben Sie Start und Ziel ein" FontSize="15"
                                       Foreground="#8B949E" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="und klicken Sie auf Verbindungen suchen" FontSize="12"
                                       Foreground="#484F58" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" x:Name="ResultsScroll" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="ResultsList" Style="{StaticResource ResultsListBox}"
                                 ItemContainerStyle="{StaticResource ResultItem}"
                                 SelectionChanged="ResultsList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:Verbindung}">
                                    <Border Background="#161B22" BorderBrush="#30363D" BorderThickness="1"
                                            CornerRadius="10" Margin="0,0,0,8" Padding="18,14" Cursor="Hand">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Abfahrtszeit}" FontSize="22"
                                                           FontWeight="Bold" Foreground="#E6EDF3"/>
                                                <TextBlock Text="{Binding Von}" FontSize="11" Foreground="#8B949E"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
                                                <Border CornerRadius="4" Padding="7,3" HorizontalAlignment="Center" Margin="0,0,0,5">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding ZugFarbe}"/>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding Zugnummer}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                                </Border>
                                                <TextBlock Text="- - - - - - - - - -" Foreground="#30363D"
                                                           HorizontalAlignment="Center" FontSize="9"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Ankunftszeit}" FontSize="22"
                                                           FontWeight="Bold" Foreground="#E6EDF3"/>
                                                <TextBlock Text="{Binding Nach}" FontSize="11" Foreground="#8B949E"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                                <TextBlock Text="{Binding Dauer}" FontSize="12"
                                                           Foreground="#8B949E" HorizontalAlignment="Center"/>
                                                <TextBlock Text="{Binding UmstiegeText}" FontSize="11"
                                                           Foreground="#8B949E" HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Preis, StringFormat='ab {0:F2} EUR'}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="#2EA043" HorizontalAlignment="Right"/>
                                                <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{Binding PuenktlichkeitFarbe}"/>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding PuenktlichkeitText}" FontSize="11" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right: Detail Panel -->
            <Border Grid.Column="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="1,0,0,0" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Details" FontSize="15" FontWeight="SemiBold"
                               Foreground="#E6EDF3" Margin="0,0,0,20"/>

                    <StackPanel x:Name="EmptyDetail" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#x1F5FA;" FontSize="38" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Verbindung auswählen" FontSize="13"
                                   Foreground="#8B949E" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer x:Name="DetailScroll" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel">
                            <Border Background="#21262D" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DetailZug" Grid.Column="0" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="#E6EDF3"/>
                                        <TextBlock x:Name="DetailDauer" Grid.Column="1" FontSize="12" Foreground="#8B949E"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Ellipse Grid.Column="0" Grid.Row="0" Width="10" Height="10"
                                                 Fill="#1F6FEB" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DetailVon" Grid.Column="1" Grid.Row="0"
                                                   FontSize="13" Foreground="#E6EDF3"/>
                                        <Rectangle Grid.Column="0" Grid.Row="1" Width="2" Height="8"
                                                   Fill="#30363D" HorizontalAlignment="Center"/>
                                        <Ellipse Grid.Column="0" Grid.Row="2" Width="10" Height="10"
                                                 Fill="#2EA043" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="DetailNach" Grid.Column="1" Grid.Row="2"
                                                   FontSize="13" Foreground="#E6EDF3"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="REISEVERLAUF" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#8B949E" Margin="0,0,0,10"/>
                                <ItemsControl x:Name="HaltestellenList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:Haltestelle}">
                                            <Grid Margin="0,0,0,2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="20"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="8" Height="8"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <SolidColorBrush Color="{Binding PunktFarbe}"/>
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13"
                                                           Foreground="{Binding TextFarbe}" Margin="8,5,0,5"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Uhrzeit}" FontSize="12"
                                                           Foreground="#8B949E" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <Border Background="#21262D" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="PREISE" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#8B949E" Margin="0,0,0,10"/>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Flexpreis" FontSize="13" Foreground="#E6EDF3"/>
                                        <TextBlock x:Name="DetailPreis1" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#2EA043" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="Sparpreis" FontSize="13" Foreground="#E6EDF3"/>
                                        <TextBlock x:Name="DetailPreis2" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#2EA043" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Super Sparpreis" FontSize="13" Foreground="#E6EDF3"/>
                                        <TextBlock x:Name="DetailPreis3" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="#2EA043" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource PrimaryButton}" Content="Jetzt buchen" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
